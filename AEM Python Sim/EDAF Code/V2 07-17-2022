#price profile integration, and objective function selection (minimize cost, minimize grid peak, maximize self-consumption)

from pyomo.environ import *
import numpy as np
import pandas as pd # Import pandas here

# Parameters
deltat = 0.25 # time delta between steps (hours) - 15 minutes
num_periods = int(24/deltat) # 24 hours * 4 (15-minute intervals per hour)

# Process dfpv for P_solar_profile
# Check if 'TimestampInUtc' is already the index, and reset if so
if 'TimestampInUtc' not in dfpv.columns and 'TimestampInUtc' in dfpv.index.name:
    dfpv.reset_index(inplace=True)
dfpv['TimestampInUtc'] = pd.to_datetime(dfpv['TimestampInUtc'])
dfpv.set_index('TimestampInUtc', inplace=True)
P_solar_profile = dfpv['PV'].values  # Solar production profile over 24 hours, 15-minute intervals
feedin_solar = 33

# Define a variable to select the objective function
objective_selector = 1 # 1 for minimize cost, 2 for minimize grid peak, 3 for maximize self-consumption

# Energy storage system parameters
SOC_max = 95 #max SoC allowed
SOC_min = 5 #min SoC allowed
charge_eff = 0.95 #charging efficiency
discharge_eff = 0.95 #discharging efficiency
E_ES_max = 100 #Energy storage capacity
P_ES_charge_max = 30 # Max. charing power
P_ES_discharge_max = 30 # Max. discharing power
SOC_init = 50 # Initial state of charge
SOC_end = 50 # Charge at the end of the window

# Generate the cost signal for 96 periods (15-minute intervals)
# Use dfcost for cost_grid
cost_grid = dfcost['vario_plus'].values
#print(cost_grid)

# Maximum power from grid
P_grid_max = 100

# Load profile from dfload dataframe
# Check if 'TimestampInUtc' is already the index, and reset if so
if 'TimestampInUtc' not in dfload.columns and 'TimestampInUtc' in dfload.index.name:
    dfload.reset_index(inplace=True)
dfload['TimestampInUtc'] = pd.to_datetime(dfload['TimestampInUtc'])
dfload.set_index('TimestampInUtc', inplace=True)
P_load = dfload['Sum'].values # Load profile over 24 hours, 15-minute intervals
## here, by using the 'Sum' column, we account for the three houses!!!

# Pyomo model
model = ConcreteModel()

# Sets
model.T = RangeSet(0, num_periods - 1)

# Parameters as Pyomo Variables
#model.P_solar = Param(model.T, initialize={i: P_solar[i] for i in range(num_periods)})
model.feedin_solar = feedin_solar
model.cost_grid = Param(model.T, initialize={i: cost_grid[i] for i in range(num_periods)})

# Decision variables
model.P_solar = Var(model.T, within=NonNegativeReals)
model.E_ES = Var(model.T, within=NonNegativeReals)
model.P_ES_charge = Var(model.T, within=NonNegativeReals)
model.P_ES_discharge = Var(model.T, within=NonNegativeReals)
model.P_grid = Var(model.T, within=Reals)
model.P_grid_peak = Var(within=NonNegativeReals)
model.P_grid_pos = Var(model.T, within=NonNegativeReals)
model.P_grid_neg = Var(model.T, within=NonNegativeReals)
model.grid_import = Var(model.T, within=Binary) # binary constraint indicating if power is imported from grid (=1), or exported (=0)
model.batterycharge_binary = Var(model.T, within=Binary) # binary constraint indicating if power is charged (=1) or discharged (=0) in the battery

# Constraints
def grid_supply_rule(model, t):
    return model.P_grid[t] == P_load[t] - model.P_solar[t] - model.P_ES_discharge[t] + model.P_ES_charge[t]
model.grid_supply = Constraint(model.T, rule=grid_supply_rule)

# Solar generation constraint (no curtailment), for curtailement replace the '==' with '<='
def solar_generation_rule(model, t):
    return model.P_solar[t] == P_solar_profile[t]
model.solar_generation = Constraint(model.T, rule=solar_generation_rule)

# Energy storage constraints (SOC limits) - Upper bound of SOC
def energy_storage_upper_limit_rule(model, t):
    return model.E_ES[t] <= (SOC_max / 100) * E_ES_max
model.energy_storage_upper_limit = Constraint(model.T, rule=energy_storage_upper_limit_rule)

# Energy storage constraints (SOC limits) - Lower bound of SOC
def energy_storage_lower_limit_rule(model, t):
    return model.E_ES[t] >= (SOC_min / 100) * E_ES_max
model.energy_storage_lower_limit = Constraint(model.T, rule=energy_storage_lower_limit_rule)

# Charging power upper limit constraint
def charging_power_upper_limit_rule(model, t):
    if t == 0:
        return model.P_ES_charge[t] == 0
    else:
        return model.P_ES_charge[t] <= model.batterycharge_binary[t] * P_ES_charge_max
model.charging_power_upper_limit = Constraint(model.T, rule=charging_power_upper_limit_rule)

# Discharging power upper limit constraint
def discharging_power_upper_limit_rule(model, t):
    if t == 0:
        return model.P_ES_discharge[t] == 0
    else:
        return model.P_ES_discharge[t] <= (1-model.batterycharge_binary[t]) * P_ES_discharge_max
model.discharging_power_upper_limit = Constraint(model.T, rule=discharging_power_upper_limit_rule)

# Initial and final state of charge constraints
def initial_SOC_rule(model):
    return model.E_ES[0] == (SOC_init / 100) * E_ES_max
model.initial_SOC = Constraint(rule=initial_SOC_rule)

def final_SOC_rule(model):
    return model.E_ES[num_periods - 1] == (SOC_end / 100) * E_ES_max
model.final_SOC = Constraint(rule=final_SOC_rule)

# State of charge constraint
def SOC_evolution_rule(model, t):
    if t > 0:
        return model.E_ES[t] == model.E_ES[t - 1] + (charge_eff * model.P_ES_charge[t] - (1 / discharge_eff) * model.P_ES_discharge[t]) * deltat
    else:
        return Constraint.Skip
model.SOC_evolution = Constraint(model.T, rule=SOC_evolution_rule)

# Grid peak power constraints
def grid_peak_constraints(model):
    return model.P_grid_peak <= P_grid_max
model.grid_peak_constraints = Constraint(rule=grid_peak_constraints)

# Split P_grid into positive and negative components
def split_P_grid_rule(model, t):
    return model.P_grid[t] == model.P_grid_pos[t] - model.P_grid_neg[t]
model.split_P_grid = Constraint(model.T, rule=split_P_grid_rule)

# Enforce mutual exclusivity between positive and negative components
def mutual_exclusivity_rule1(model, t):
    return model.P_grid_pos[t] <= model.grid_import[t] *  P_grid_max
model.mutual_exclusivity = Constraint(model.T, rule=mutual_exclusivity_rule1)

def mutual_exclusivity_rule2(model, t):
    return model.P_grid_neg[t] <= (1-model.grid_import[t]) *  P_grid_max
model.mutual_exclusivity = Constraint(model.T, rule=mutual_exclusivity_rule2)

# Grid peak power upper bound constraint
def grid_peak_power_upper_limit_rule(model, t):
    return model.P_grid[t] <= model.P_grid_peak
model.grid_peak_power_upper_limit = Constraint(model.T, rule=grid_peak_power_upper_limit_rule)

# Grid peak power lower bound constraint
def grid_peak_power_lower_limit_rule(model, t):
    return model.P_grid[t] >= -model.P_grid_peak
model.grid_peak_power_lower_limit = Constraint(model.T, rule=grid_peak_power_lower_limit_rule)

# Define the objective functions
def objective_minimize_cost(model):
    return sum(model.P_grid_pos[t] * model.cost_grid[t] - model.P_grid_neg[t] * model.feedin_solar for t in model.T)

def objective_minimize_grid_peak(model):
    return model.P_grid_peak

def objective_max_selfconsumption(model):
    return sum(model.P_grid_pos[t] for t in model.T)

# Select the objective function based on the selector variable
if objective_selector == 1:
    model.obj = Objective(rule=objective_minimize_cost, sense=minimize)
elif objective_selector == 2:
    model.obj = Objective(rule=objective_minimize_grid_peak, sense=minimize)
elif objective_selector == 3:
    model.obj = Objective(rule=objective_max_selfconsumption, sense=minimize)
else:
    raise ValueError("Invalid objective selector value. Choose 1, 2, or 3.")


# Solver: CBC
solver = SolverFactory('cbc')
solver.solve(model, tee=True)

